POSTGRES_DB=resolveai_v2
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://resolveai:replace-me@127.0.0.1:5432/resolveai_v2

OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_PROVIDER=streamlake/fp8
OPENROUTER_RETRY_PROVIDER=deepinfra/fp8
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.3-flash
OPENROUTER_FALLBACK_PROVIDER=sail-research/us
OPENROUTER_MAX_OUTPUT_TOKENS=4096
EVAL_BUDGET_USD=1.00
EVAL_STOP_USD=0.90
EVAL_FALLBACK_BUDGET_USD=0.10
# Google SDK is retained ONLY for unchanged embeddings.
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1024
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RETRIEVAL_MODE=vector_only

MERCHANT_URL=http://127.0.0.1:8002
PLATFORM_URL=http://127.0.0.1:8001
WAREHOUSE_URL=http://127.0.0.1:8003

SUPPORT_MAX_TOOL_CALLS=6
SUPPORT_MAX_INVESTIGATION_MS=20000
SUPPORT_MAX_CONSECUTIVE_ERRORS=2
SUPPORT_MAX_TOOL_ERRORS=3

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=resolveai-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
